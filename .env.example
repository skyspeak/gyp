# Turso / libSQL. Omit both to use a local file DB (file:./local.db) in dev.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Resend, for deadline reminder emails
RESEND_API_KEY=
RESEND_FROM_EMAIL="Deadline Name <deadlines@yourdomain.com>"

# Extraction key for the nightly verification cron. Set EITHER one — whichever
# is present is used, and Gemini wins if both are. Without either, the cron
# logs and no-ops rather than failing.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Shared secret required as ?token= on /api/cron/* routes, checked against
# the Authorization header Vercel Cron sends (or curl for manual runs).
CRON_SECRET=

# Base URL used in emails for links back to the app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Basic-auth style credentials for the /admin review queue (phase 1 has no accounts)
ADMIN_USER=
ADMIN_PASSWORD=

# Optional: where funding-risk alerts from the verification cron get emailed
ADMIN_EMAIL=

# Optional: override the extraction model used by the verification cron
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-4-6
